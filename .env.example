# 复制为 .env 后填写真实值。此文件不含任何真实凭据，可安全提交。

# ---- Server ----
# 19080 / 19073 是刻意挑的：8080 与 5173 在共享机器上会撞别的服务，
# 3000/8000/9000/9090 又太常见。PORT 必须与 frontend/vite.config.ts 的
# BACKEND_PORT 默认值一致，否则前端代理会指向一个没人监听的端口。
PORT=19080
GIN_MODE=debug
APP_TIMEZONE=Australia/Melbourne

# CORS 白名单（逗号分隔）。这一项不是只给直连调用方用的，它是必经之路：
# 浏览器请求 /api 时，代理（Vite dev / preview）只改写 Host（changeOrigin: true），
# 浏览器的 Origin 原样转发到后端，于是 gin-contrib/cors 的「Origin 等于 Host 就放行」
# 那条捷径永远不成立 —— Origin 不在这个列表里就直接 403，且响应体为空。
# ⇒ 部署到 ECS 必须取消注释下面这行并填成前端地址（出厂是注释状态，照抄最容易漏掉）。
# 不填则用默认的 localhost / 127.0.0.1:19073，线上登录会 403。
# 配错的表现：403 且响应体为空，服务端日志里有且只有一行 | 403 | ... POST "/api/v1/auth/login"。
# CORS_ORIGINS=http://<ecs-ip>:19073
# 另：本文件的中文注释在复制成 .env 后建议删掉 —— .env 里只要有一个非法字节，整份都会失效
# （godotenv 全有或全无），定位方法见 deploy.md §6.4。

# ---- Database ----
# loc=Australia%2FMelbourne：DATETIME 按墨尔本本地时间解析，不做时区转换
DB_DSN="user:password@tcp(127.0.0.1:3306)/student_management?charset=utf8mb4&parseTime=true&loc=Australia%2FMelbourne"

# ---- Auth ----
JWT_SECRET=replace-with-a-random-string
JWT_TTL_MINUTES=120

# ---- LLM (DeepSeek, OpenAI 兼容协议) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
