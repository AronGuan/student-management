# 复制为 .env 后填写真实值。此文件不含任何真实凭据，可安全提交。

# ---- Server ----
# 19080 / 19073 是刻意挑的：8080 与 5173 在共享机器上会撞别的服务，
# 3000/8000/9000/9090 又太常见。PORT 必须与 frontend/vite.config.ts 的
# BACKEND_PORT 默认值一致，否则前端代理会指向一个没人监听的端口。
PORT=19080
GIN_MODE=debug
APP_TIMEZONE=Australia/Melbourne

# CORS 白名单（逗号分隔）。浏览器正常情况下走前端同源的 /api 代理，不触发 CORS；
# 这一项是给直连的调用方用的。部署到 ECS 后要把前端地址填进来，例如
# CORS_ORIGINS=http://<ecs-ip>:19073
# 不填则用默认的 localhost / 127.0.0.1:19073。

# ---- Database ----
# loc=Australia%2FMelbourne：DATETIME 按墨尔本本地时间解析，不做时区转换
DB_DSN="user:password@tcp(127.0.0.1:3306)/student_management?charset=utf8mb4&parseTime=true&loc=Australia%2FMelbourne"

# ---- Auth ----
JWT_SECRET=replace-with-a-random-string
JWT_TTL_MINUTES=120

# ---- LLM (DeepSeek, OpenAI 兼容协议) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
