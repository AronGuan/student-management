# 复制为 .env 后填写真实值。此文件不含任何真实凭据，可安全提交。

# ---- Server ----
PORT=8080
GIN_MODE=debug
APP_TIMEZONE=Australia/Melbourne

# ---- Database ----
# loc=Australia%2FMelbourne：DATETIME 按墨尔本本地时间解析，不做时区转换
DB_DSN="user:password@tcp(127.0.0.1:3306)/student_management?charset=utf8mb4&parseTime=true&loc=Australia%2FMelbourne"

# ---- Auth ----
JWT_SECRET=replace-with-a-random-string
JWT_TTL_MINUTES=120

# ---- LLM (DeepSeek, OpenAI 兼容协议) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
